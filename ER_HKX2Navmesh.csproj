<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Resources\" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="SoulsFormats">
      <HintPath>Resources\SoulsFormats.dll</HintPath>
    </Reference>
    <Reference Include="ERNavmeshGenCS">
      <HintPath>Resources\ERNavmeshGenCS.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="Resources\*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="CopyFileToRoot" AfterTargets="AfterBuild">
    <Copy SourceFiles="Resources\ERNavmeshGen.dll" DestinationFolder="$(OutDir)" />
    <Copy SourceFiles="Resources\ERNavmeshGenCS.dll" DestinationFolder="$(OutDir)" />
    <Copy SourceFiles="Resources\Zydis.dll" DestinationFolder="$(OutDir)" />
    <Copy SourceFiles="Resources\SoulsFormats.dll" DestinationFolder="$(OutDir)" />
    <Copy SourceFiles="Resources\keystone.dll" DestinationFolder="$(OutDir)" />
  </Target>

</Project>